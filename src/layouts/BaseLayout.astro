---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

const {
  title = "Portfolio",
  description = "Portfolio en construcción",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Inter (body) + Source Serif 4 (headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme: default DARK + persist across navigation -->
    <script>
      (() => {
        const KEY = "theme";
        const DEFAULT = "dark"; // <-- dark por defecto
        try {
          const saved = localStorage.getItem(KEY);
          const theme = (saved === "light" || saved === "dark") ? saved : DEFAULT;

          // si no había guardado, lo guardamos para que se mantenga siempre
          if (!saved) localStorage.setItem(KEY, theme);

          document.documentElement.dataset.theme = theme;
        } catch {
          // si localStorage falla, al menos dejamos dark (ya viene en <html data-theme="dark">)
          document.documentElement.dataset.theme = DEFAULT;
        }
      })();
    </script>
  </head>

  <body>
    <header class="header">
      <div class="container">
        <Nav />
      </div>
    </header>

    <main class="container main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <small class="muted">© {new Date().getFullYear()} DarioSF — Lorem ipsum</small>
      </div>
    </footer>
  </body>
</html>

<style>
  .header{
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .main{ padding: 28px 0 64px; }
  .footer{ border-top: 1px solid var(--border); padding: 22px 0; }
</style>
