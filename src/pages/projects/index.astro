---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const featured = projects.filter((p) => p.data.featured);
featured.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="DarioSF | Portfolio" description="Portfolio en construcción">
  <section class="hero">
    <h1>DarioSF</h1>
    <p class="lead muted">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.
    </p>
  </section>

  <section class="grid">
    <div class="card">
      <h2>Focus</h2>
      <p class="muted">
        Lorem ipsum: aquí resumirás tu enfoque aeroespacial/aerodinámica en 2–3 líneas.
      </p>

      <ul>
        <li><strong>Domain:</strong> Lorem ipsum (CFD / Avionics / GNC / HPC)</li>
        <li><strong>Methods:</strong> Lorem ipsum (validation, benchmarking, tooling)</li>
        <li><strong>Stack:</strong> Lorem ipsum (C++ / Python / ROS / OpenFOAM…)</li>
      </ul>

      <p class="muted">
        Lorem ipsum: una frase corta de “engineering mindset”.
      </p>
    </div>

    <div class="card">
      <h2>Featured projects</h2>

      <ul class="list">
        {featured.map((p) => (
          <li class="item">
            <div class="top">
              <a class="name" href={`/projects/${p.slug}`}>{p.data.title}</a>
              <span class={`status status--${p.data.status}`}>
                {p.data.status}
              </span>
            </div>
            <div class="muted meta">{p.data.date} · {p.data.tags.join(", ")}</div>
            <div class="muted">{p.data.summary}</div>
          </li>
        ))}
      </ul>

      <p class="more">
        <a href="/projects">Browse all projects →</a>
      </p>
    </div>
  </section>

  <section class="card note">
    <h2>Contact</h2>
    <p class="muted">Lorem ipsum: aquí irá un CTA claro (email/LinkedIn) para reclutadores.</p>
    <p><a href="/contact">Go to contact →</a></p>
  </section>
</BaseLayout>

<style>
  .hero{
    padding: 10px 0 18px;
  }
  .lead{
    font-size: 1.05rem;
    max-width: 70ch;
  }

  .grid{
    display:grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 12px;
  }

  @media (min-width: 980px){
    .grid{
      grid-template-columns: 1fr 1fr;
    }
  }

  .list{
    list-style:none;
    padding:0;
    margin: 10px 0 0;
    display:flex;
    flex-direction:column;
    gap: 12px;
  }

  .item{
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .item:first-child{
    border-top: none;
    padding-top: 0;
  }

  .top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 10px;
  }

  .name{
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }
  .name:hover{
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .meta{
    font-size: .9rem;
    margin-top: 4px;
  }

  .more{
    margin-top: 14px;
  }

  .note{
    margin-top: 14px;
  }
</style>
