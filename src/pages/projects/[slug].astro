---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const statusLabel = {
  "concept": "Concept",
  "in-progress": "In progress",
  "completed": "Completed",
};
---

<BaseLayout
  title={`${project.data.title} | DarioSF`}
  description={project.data.summary}
>
  <article class="article">
    <p><a href="/projects">← Volver a Projects</a></p>

    <header class="head">
      <h1>{project.data.title}</h1>
      <p class="muted">{project.data.summary}</p>

      <div class="meta">
        <span class="muted">{project.data.date}</span>
        <span class={`status status--${project.data.status}`}>
          {statusLabel[project.data.status]}
        </span>
      </div>

      <div class="chips">
        {project.data.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>

      <p class="links">
        {project.data.repoUrl ? <a href={project.data.repoUrl} target="_blank" rel="noopener">Repo</a> : null}
        {project.data.demoUrl ? <span> · <a href={project.data.demoUrl} target="_blank" rel="noopener">Demo</a></span> : null}
      </p>
    </header>

    <hr />

    <Content />
  </article>
</BaseLayout>

<style>
  .article { max-width: 820px; }
  .head { margin-top: 10px; }
  .meta { display:flex; gap: 10px; align-items:center; margin-top: 10px; }
  .links { margin-top: 14px; }
</style>
