---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectMeta from "../../components/ProjectMeta.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const statusLabel = {
  "concept": "Concept",
  "in-progress": "In progress",
  "completed": "Completed",
};
---

<BaseLayout
  title={`${project.data.title} | DarioSF`}
  description={project.data.summary}
>
  <article class="article">
    <p><a href="/projects">← Volver a Projects</a></p>

    <header class="head">
      <h1>{project.data.title}</h1>
      <p class="muted">{project.data.summary}</p>
      <ProjectMeta project={project} statusLabel={statusLabel} />
    </header>

    <hr />

    <Content />
  </article>
</BaseLayout>

<style>
  .article { max-width: 820px; }
  .head { margin-top: 10px; }
  .meta { display:flex; gap: 10px; align-items:center; margin-top: 10px; }
  .links { margin-top: 14px; }
</style>
